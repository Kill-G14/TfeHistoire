# Configuration sensible
/BackEnd/config.php
/BackEnd/.env
.env.example
env.exemple
credentials.txt
*.credentials.txt
.htaccess

# Fichiers de développement (ne pas déployer)
DOCUMENTATION_TECHNIQUE.md
.claude

# Scripts et documentation de versioning (outils de développement)
bump-version.sh
bump-version.bat

# Base de données (ne pas commit les structures SQL locales)
# Aucun script SQL dans le dépôt (structures, migrations, dumps) : à garder hors Git
/BackEnd/*.sql
/BackEnd/database.sql
/BackEnd/database_production.sql
/BackEnd/migration_rate_limiter_contact.sql

# Dépendances
/BackEnd/vendor/
/node_modules/

# Logs
/BackEnd/logs/
/BackEnd/vendor/logs/*.log
*.log

# Fichiers temporaires
*.tmp
*.temp

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editeurs
.vscode/
.idea/
*.swp
*.swo
*~

# Images uploadées (garder le dossier mais pas les fichiers)
/BackEnd/storage/thumbnails/
/BackEnd/storage/images/*
!/BackEnd/storage/images/.gitkeep
/BackEnd/Src/img/*
!/BackEnd/Src/img/.gitkeep

# Tickets générés
/BackEnd/storage/tickets/*.pdf

# Configuration sensible (optionnel si vous voulez protéger routeApi.php)
# /BackEnd/Api/routeApi.php
